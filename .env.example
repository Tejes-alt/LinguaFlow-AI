# Get a free key at https://rapidapi.com after subscribing to the
# "Microsoft Translator Text" API (see README.md for step-by-step setup).
VITE_RAPIDAPI_KEY=

# Only change this if you subscribe to a different translation provider on
# RapidAPI. If you do, also update src/services/rapidApi.js to match that
# provider's request/response shape.
VITE_RAPIDAPI_HOST=microsoft-translator-text.p.rapidapi.com
